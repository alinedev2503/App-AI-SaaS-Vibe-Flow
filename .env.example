# ────────────────────────────────────
# Vibe flow — Environment Configuration
# ────────────────────────────────────
# Copy this file to .env.local and fill in your values.

# ── AI ──
GEMINI_API_KEY=""

# ── App ──
APP_URL="http://localhost:3000"
PORT=3001
JWT_SECRET="change-this-to-a-random-secret-in-production"
JWT_EXPIRES_IN="7d"

# ── Database ──
# Options: sqlite (default), supabase, firebase
DB_TYPE="sqlite"
DB_PATH="data/vibeflow.db"

# ── Supabase (only if DB_TYPE=supabase) ──
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_KEY=""

# ── Firebase (only if DB_TYPE=firebase) ──
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_DATABASE_URL=""

# ── SEO / Analytics ──
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_ID=""
# Google Search Console verification string
VITE_GOOGLE_VERIFICATION=""
