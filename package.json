{
  "name": "vibeflow",
  "private": false,
  "version": "1.0.0",
  "description": "VibeFlow — Autonomous AI Workforce Platform. Orchestrate, monitor, and manage AI agents with native human-in-the-loop supervision.",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build && npx tsx scripts/postbuild.ts && tsc --project tsconfig.server.json",
    "build:analyze": "ANALYZE=true vite build && npx tsx scripts/postbuild.ts",
    "predeploy": "GH_PAGES=true npm run build",
    "deploy": "gh-pages -d dist -b gh-pages --dotfiles",
    "start": "node dist/server/index.js",
    "preview": "vite preview",
    "setup": "npx tsx scripts/setup.ts",
    "secret": "npx tsx scripts/generate-secret.ts",
    "backup": "npx tsx scripts/backup.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^1.4.5-lts.2",
    "pino": "^10.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.1.3",
    "rollup-plugin-visualizer": "^6.0.11",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-sitemap": "^0.8.2",
    "vitest": "^4.1.10"
  }
}
